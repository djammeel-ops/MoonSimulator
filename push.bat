@echo off
chcp 65001 >nul
echo ===================================================
echo       محاكي القمر - أداة الرفع التلقائي إلى GitHub
echo ===================================================
echo.

set /p msg="ادخل وصف التعديل (أو اضغط Enter للوصف التلقائي): "
if "%msg%"=="" (
    set msg=تحديث المشروع وتطوير الميزات بتاريخ %date% %time%
)

echo.
echo [1/3] جاري تجهيز الملفات المعدلة...
git add .

echo [2/3] جاري حفظ التعديل محلياً...
git commit -m "%msg%"

echo [3/3] جاري الرفع إلى GitHub...
git push origin main

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ===================================================
    echo           تم الرفع بنجاح تام إلى GitHub!
    echo ===================================================
) else (
    echo.
    echo حدث خطأ أثناء الرفع، تأكد من اتصال الإنترنت وحاول مجدداً.
)

echo.
pause
